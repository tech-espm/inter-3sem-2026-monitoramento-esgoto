<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>SewerWatch - Dashboard</title>
    <link rel="stylesheet" href="style.css">
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
</head>
<body>
    <div class="container">
      <header style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px;">
    <div style="display: flex; align-items: center; gap: 20px;">
        <div class="logo" style="font-weight: bold; font-size: 1.2rem;">SewerWatch</div>
        
        <a href="home.html" style="
            text-decoration: none; 
            color: #38bdf8; 
            border: 1px solid #38bdf8; 
            padding: 5px 15px; 
            border-radius: 5px; 
            font-size: 0.8rem;
            transition: 0.3s;
        " onmouseover="this.style.background='rgba(56, 189, 248, 0.1)'" onmouseout="this.style.background='transparent'">
            ← Voltar para Home
        </a>
    </div>

    <div class="status-top">GS301-915M 🟢</div>
</header>

        <section class="alert-banner">
            <div class="alert-icon">⚠️</div>
            <div class="alert-content">
                <strong>Alerta Ativo</strong>
                <p>Variações anômalas detectadas. Investigação recomendada.</p>
            </div>
            <div class="alert-time">Atualizado: 09/03/2026 14:35:22</div>
        </section>

        <section class="sensors-grid">
            <div class="card sensor-card alert">
                <div class="card-header">
                    <span>odor01</span>
                    <span class="badge">Alerta</span>
                </div>
                <div class="sensor-value" id="valor-odor-realtime">carregando...</div>
                <div class="mini-chart"></div>
            </div>

            <div class="card sensor-card online">
                <div class="card-header">
                    <span>odor02</span>
                    <span class="badge">Online</span>
                </div>
                <div class="sensor-value">49.1 <small>ppm</small></div>
                <div class="mini-chart"></div>
            </div>
        </section>

        <section class="main-charts">
            <div class="card chart-large">
                <h3>Variação de Odor (H₂S ppm)</h3>
                <div class="chart-container" style="position: relative; height: 280px;">
                    <canvas id="chart-odor"></canvas>
                </div>
            </div>
            <div class="card chart-large">
                <h3>Pressão da Tubulação (bar)</h3>
                <div class="chart-container" style="position: relative; height: 280px;">
                    <canvas id="chart-pressure"></canvas>
                </div>
            </div>
        </section>

        <section class="correlation-area" style="margin-top: 20px;">
            <div class="card">
                <h3>Correlação Odor x Pressão</h3>
                <div class="chart-container" style="position: relative; height: 280px;">
                    <canvas id="chart-correlation"></canvas>
                </div>
            </div>
        </section>

        <section class="bottom-grid" style="margin-top: 20px; display: grid; grid-template-columns: 1fr 1fr; gap: 20px;">
            <div class="card alerts-list">
                <h3>Alertas e Detecção de Problemas</h3>
                <div class="alert-item high" style="padding: 10px; background: rgba(255,0,0,0.1); margin-top: 10px; border-radius: 4px;">
                    Vazamento [odor01]
                </div>
                <div class="alert-item medium" style="padding: 10px; background: rgba(255,165,0,0.1); margin-top: 10px; border-radius: 4px;">
                    Anomalia [odor01]
                </div>
            </div>
            <div class="card pipe-diagram">
                <h3>Diagrama da Tubulação</h3>
                <div class="diagram-placeholder" style="height: 100px; border: 1px dashed #444; display: flex; align-items: center; justify-content: center; margin-top: 10px;">
                    Visualização do Sistema
                </div>
            </div>
        </section>
    </div>

    <script>
        // Configuração do Gráfico
        const ctxOdor = document.getElementById('chart-odor').getContext('2d');
        const meuGraficoOdor = new Chart(ctxOdor, {
            type: 'line',
            data: { 
                labels: [], 
                datasets: [{ 
                    label: 'H2S ppm', 
                    data: [],
                    borderColor: '#10b981',
                    backgroundColor: 'rgba(16, 185, 129, 0.1)',
                    fill: true,
                    tension: 0.3
                }] 
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                scales: { y: { beginAtZero: true } }
            }
        });

        async function atualizarDados() {
            // Nova tentativa com AllOrigins (formato que costuma burlar melhor o CORS)
            const targetUrl = 'https://iagen.espm.br/sensores/dados?sensor=odor&data_inicial=2026-01-01&data_final=2027-01-01';
            const proxyUrl = `https://api.allorigins.win/get?url=${encodeURIComponent(targetUrl)}`;
            
            try {
                const resposta = await fetch(proxyUrl);
                const dadosProxy = await resposta.json();
                
                // O AllOrigins retorna o JSON dentro de uma string chamada 'contents'
                const todosDados = JSON.parse(dadosProxy.contents);

                if (todosDados && todosDados.length > 0) {
                    const ultimosVinte = todosDados.slice(-20);
                    
                    const labels = ultimosVinte.map(d => d.data.split(' ')[1]);
                    const valores = ultimosVinte.map(d => parseFloat(d.h2s));

                    meuGraficoOdor.data.labels = labels;
                    meuGraficoOdor.data.datasets[0].data = valores;
                    meuGraficoOdor.update();

                    const ultimoVal = valores[valores.length - 1];
                    document.getElementById('valor-odor-realtime').innerHTML = `${ultimoVal.toFixed(2)} <small>ppm</small>`;
                }
            } catch (err) {
                console.error("Erro na busca:", err);
                // Se der erro, ele exibe no card. 
                // Se o AllOrigins falhar, pode ser necessário rodar o Chrome com segurança desativada para fins de teste.
                document.getElementById('valor-odor-realtime').innerText = "Erro de Conexão";
            }
        }

        atualizarDados();
        setInterval(atualizarDados, 10000);
    </script>
</body>
</html>