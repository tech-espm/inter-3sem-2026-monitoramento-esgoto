<div class="container">
	<% var temAlertas = alertas && alertas.length > 0; %>

	<% if (temAlertas) { %>
	<section class="alert-banner critico">
		<div class="alert-banner-text">
			<strong><%= alertas.length %> alerta(s) ativo(s)</strong>
			<p>Verifique os sensores com leituras acima do limite configurado.</p>
		</div>
		<div class="alert-time">Atualizado: <%= new Date(atualizadoEm).toLocaleString("pt-BR") %></div>
	</section>
	<% } else { %>
	<section class="alert-banner ok">
		<div class="alert-banner-text">
			<strong>Sistema operando normalmente</strong>
			<p>Nenhum alerta crítico pendente no momento.</p>
		</div>
		<div class="alert-time">Atualizado: <%= new Date(atualizadoEm).toLocaleString("pt-BR") %></div>
	</section>
	<% } %>

	<section class="sensors-grid">
		<% if (!cards || !cards.length) { %>
			<div class="card empty-state">
				<p>Nenhum sensor ativo. <a href="/sensores/novo">Cadastre um sensor</a>.</p>
			</div>
		<% } %>
		<% for (var i = 0; i < (cards || []).length; i++) {
			var c = cards[i];
		%>
		<div class="card <%= c.classe %>">
			<div class="card-header">
				<span class="sensor-code"><%= c.codigo %></span>
				<span class="badge badge-<%= c.status === 'alert' ? 'alerta' : (c.status === 'online' ? 'online' : 'offline') %>"><%= c.badge %></span>
			</div>
			<div class="sensor-value"><%- c.valorHtml %></div>
			<p class="sensor-loc"><%= c.localizacao %></p>
		</div>
		<% } %>
	</section>

	<section class="main-charts">
		<div class="card chart-card">
			<h3>H₂S — odor (ppm)</h3>
			<div class="chart-container"><canvas id="chart-odor"></canvas></div>
		</div>
		<div class="card chart-card">
			<h3>Nível de esgoto (%)</h3>
			<div class="chart-container"><canvas id="chart-nivel"></canvas></div>
		</div>
	</section>

	<section class="main-charts">
		<div class="card chart-card">
			<h3>Pressão (bar)</h3>
			<div class="chart-container"><canvas id="chart-pressao"></canvas></div>
		</div>
		<div class="card chart-card">
			<h3>Temperatura e umidade</h3>
			<div class="chart-container"><canvas id="chart-temp"></canvas></div>
		</div>
	</section>

	<section class="bottom-grid">
		<div class="card">
			<h3>Alertas recentes</h3>
			<% if (!temAlertas) { %>
				<p class="muted">Nenhum alerta aberto.</p>
			<% } %>
			<% for (var j = 0; j < (alertas || []).length; j++) { %>
				<div class="alert-item <%= alertas[j].severidade %>">
					<strong>[<%= alertas[j].codigo %>]</strong> <%= alertas[j].mensagem %>
					<small><%= new Date(alertas[j].data).toLocaleString("pt-BR") %></small>
				</div>
			<% } %>
			<a href="/alertas" class="btn btn-secondary btn-sm">Ver todos os alertas</a>
		</div>
		<div class="card">
			<h3>Rede de monitoramento</h3>
			<div class="pipe-line">
				<% for (var k = 0; k < Math.min((cards || []).length, 4); k++) {
					var node = cards[k];
				%>
				<div class="pipe-node <%= node.status === 'alert' ? 'alerta' : (node.status === 'online' ? 'ativo' : '') %>">
					<%= node.codigo %>
					<small><%= node.tipo %></small>
				</div>
				<% if (k < Math.min((cards || []).length, 4) - 1) { %><span class="pipe-arrow">→</span><% } %>
				<% } %>
			</div>
		</div>
	</section>
</div>

<%- contentFor("espaco-head") %>
<script>
(function () {
	var graficos = <%- JSON.stringify(graficos || {}) %>;

	function criarLinha(id, label, labels, values, cor) {
		var el = document.getElementById(id);
		if (!el || !labels.length) return;
		new Chart(el, {
			type: "line",
			data: {
				labels: labels,
				datasets: [{
					label: label,
					data: values,
					borderColor: cor,
					backgroundColor: cor + "33",
					fill: true,
					tension: 0.35,
					pointRadius: 3
				}]
			},
			options: {
				responsive: true,
				maintainAspectRatio: false,
				plugins: { legend: { labels: { color: "#94a3b8" } } },
				scales: {
					x: { ticks: { color: "#64748b" }, grid: { color: "#334155" } },
					y: { beginAtZero: true, ticks: { color: "#64748b" }, grid: { color: "#334155" } }
				}
			}
		});
	}

	if (graficos.graficoOdor) {
		criarLinha("chart-odor", "H2S", graficos.graficoOdor.labels, graficos.graficoOdor.values, "#22d3ee");
	}
	if (graficos.graficoNivel) {
		criarLinha("chart-nivel", "Nivel %", graficos.graficoNivel.labels, graficos.graficoNivel.values, "#4ade80");
	}
	if (graficos.graficoPressao) {
		criarLinha("chart-pressao", "Pressao", graficos.graficoPressao.labels, graficos.graficoPressao.values, "#fbbf24");
	}
	if (graficos.graficoTemp && graficos.graficoTemp.labels.length) {
		var elTemp = document.getElementById("chart-temp");
		if (elTemp) {
			new Chart(elTemp, {
				type: "line",
				data: {
					labels: graficos.graficoTemp.labels,
					datasets: [
						{ label: "Temp C", data: graficos.graficoTemp.temp, borderColor: "#f87171", tension: 0.35 },
						{ label: "Umidade %", data: graficos.graficoTemp.umidade, borderColor: "#a78bfa", tension: 0.35 }
					]
				},
				options: {
					responsive: true,
					maintainAspectRatio: false,
					plugins: { legend: { labels: { color: "#94a3b8" } } },
					scales: {
						x: { ticks: { color: "#64748b" }, grid: { color: "#334155" } },
						y: { ticks: { color: "#64748b" }, grid: { color: "#334155" } }
					}
				}
			});
		}
	}
})();
</script>
