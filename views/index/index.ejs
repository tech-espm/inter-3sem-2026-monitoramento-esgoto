<div class="hero-panel">
	<h1>Monitoramento de Esgoto</h1>
	<p class="hero-sub">Bem-vindo, <strong><%= usuario %></strong>. Visão geral do SewerWatch.</p>

	<% if (avisoDb) { %>
		<div class="banner-warn"><%= avisoDb %></div>
	<% } %>
	<% if (sincronizados > 0) { %>
		<div class="banner-ok"><%= sincronizados %> leitura(s) de odor sincronizada(s) com a API ESPM.</div>
	<% } %>
</div>

<div class="grid-4">
	<div class="card stat-card">
		<div class="stat-icon">📡</div>
		<div class="stat-value"><%= resumo.sensoresAtivos %></div>
		<div class="stat-label">Sensores ativos</div>
	</div>
	<div class="card stat-card">
		<div class="stat-icon">⚠️</div>
		<div class="stat-value"><%= resumo.alertasAbertos %></div>
		<div class="stat-label">Alertas abertos</div>
	</div>
	<div class="card stat-card">
		<div class="stat-icon">💧</div>
		<div class="stat-value">
			<% if (resumo.ultimoNivel) { %>
				<%= parseFloat(resumo.ultimoNivel.nivel_percentual).toFixed(1) %>%
			<% } else { %>—<% } %>
		</div>
		<div class="stat-label">Último nível</div>
	</div>
	<div class="card stat-card">
		<div class="stat-icon">🧪</div>
		<div class="stat-value">
			<% if (resumo.ultimoOdor.length) { %>
				<%= parseFloat(resumo.ultimoOdor[0].h2s).toFixed(3) %>
			<% } else { %>—<% } %>
		</div>
		<div class="stat-label">H₂S recente (ppm)</div>
	</div>
</div>

<div class="quick-actions card">
	<h2>Acesso rápido</h2>
	<div class="btn-row">
		<a class="btn btn-primary" href="/dashboard">Dashboard</a>
		<a class="btn btn-secondary" href="/sensores">Sensores</a>
		<a class="btn btn-secondary" href="/niveis">Níveis</a>
		<a class="btn btn-secondary" href="/alertas">Alertas</a>
	</div>
</div>

<div class="card">
	<h2>Últimas leituras de odor</h2>
	<% if (!resumo.ultimoOdor.length) { %>
		<p class="muted">Sem leituras. O sistema cria dados de exemplo na primeira execução com MySQL ativo.</p>
	<% } else { %>
		<table class="table">
			<thead><tr><th>Sensor</th><th>H₂S</th><th>Bateria</th><th>Data</th></tr></thead>
			<tbody>
			<% for (var i = 0; i < resumo.ultimoOdor.length; i++) { %>
				<tr>
					<td><span class="tag">odor<%= String(resumo.ultimoOdor[i].id_sensor).padStart(2, "0") %></span></td>
					<td><%= parseFloat(resumo.ultimoOdor[i].h2s).toFixed(3) %> ppm</td>
					<td><%= resumo.ultimoOdor[i].bateria %>%</td>
					<td><%= new Date(resumo.ultimoOdor[i].data).toLocaleString("pt-BR") %></td>
				</tr>
			<% } %>
			</tbody>
		</table>
	<% } %>
</div>
