{
  "name": "monitoramento-esgoto",
  "version": "1.0.0",
  "description": "Sistema web de monitoramento de esgoto - ESPM",
  "main": "app.js",
  "scripts": {
    "start": "node app.js",
    "dev": "node app.js",
    "db:init": "node -e \"require('dotenv').config();const s=require('./data/sql');s.init({connectionLimit:30,waitForConnections:true,charset:process.env.sql_charset,host:process.env.sql_host,port:parseInt(process.env.sql_port),user:process.env.sql_user,password:process.env.sql_password,database:process.env.sql_database});require('./data/init-db').ensureSchema().then(()=>process.exit(0)).catch(e=>{console.error(e);process.exit(1)})\""
  },
  "author": "ESPM",
  "license": "MIT",
  "dependencies": {
    "axios": "1.15.2",
    "compression": "1.8.1",
    "cookie-parser": "1.4.7",
    "dotenv": "17.2.2",
    "ejs": "3.1.10",
    "express": "4.21.2",
    "express-async-error-wrapper": "1.0.4",
    "express-ejs-layouts": "2.5.1",
    "lru-cache": "7.10.1",
    "multer": "1.4.5-lts.1",
    "mysql2": "3.10.3"
  },
  "devDependencies": {
    "@types/express": "4.17.21",
    "@types/express-serve-static-core": "4.19.5",
    "@types/node": "14.14.21"
  }
}
